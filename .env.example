# --- Core ---------------------------------------------------------------------

# Public URL of the app, without a trailing slash. Use http://localhost:5173 for `bun run dev`.
ORIGIN=http://localhost:3000

# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Set to true to close registration after creating your own account.
DISABLE_SIGNUP=false

# Where compose.yaml publishes the app. The default loopback address only accepts connections
# from this machine (and a reverse proxy running on it). Use 0.0.0.0 to serve other machines
# directly, without a proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Behind a reverse proxy, read the client address from its header so sign-in throttling works
# per client (XFF_DEPTH = number of trusted proxies). Only set these when the proxy is the sole
# way to reach the app (APP_BIND_ADDRESS=127.0.0.1); otherwise clients can forge the header.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- Database -------------------------------------------------------------------

# The app builds its connection string from these three values. Defaults connect to
# localhost:5432. Use letters and digits only for the password (e.g. `openssl rand -hex 24`)
# so Docker Compose can pass it through.
POSTGRES_USER=homefit
POSTGRES_PASSWORD=
POSTGRES_DB=homefit

# Optional. `bun run dev` connects to POSTGRES_HOST:POSTGRES_PORT (default localhost:5432).
# The Compose app container always uses hostname `db` and port 5432. `docker compose up`
# keeps the database on the Compose network. `bun run db:start` publishes it on
# POSTGRES_PORT for tools on this machine.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Apply pending migrations at startup, and run background jobs in this process.
RUN_MIGRATIONS=true
BACKGROUND_JOBS=true

# `main` (the default) is your data. `test` is the disposable stack from compose.test.yaml.
# The test process only starts when POSTGRES_DB is homefit_test and Google Health is unset.
# HOMEFIT_INSTANCE=main

# --- Google Health (optional) -----------------------------------------------------
# Leave the client ID, client secret and encryption key empty to disable the integration.
# See docs/google-health-setup.md.

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Base64 of 32 random bytes: `openssl rand -base64 32`
GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY_VERSION=v1
GOOGLE_HEALTH_TOKEN_PREVIOUS_KEYS={}
# Defaults to ${ORIGIN}/api/google-health/oauth/callback
GOOGLE_HEALTH_REDIRECT_URI=
# Exact Authorization header Google sends to /api/google-health/webhook. Leave empty to rely on
# daily and manual reconciliation only (webhooks need a public HTTPS URL).
GOOGLE_HEALTH_WEBHOOK_AUTHORIZATION=
# Setup-only values used when creating the webhook subscriber (not read by the app).
GOOGLE_HEALTH_PROJECT_NUMBER=
GOOGLE_HEALTH_SUBSCRIBER_ID=homefit-health
