{
	"name": "homefit",
	"private": true,
	"version": "0.1.0",
	"description": "Self-hosted dashboard for sleep, training and health data.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun server.js",
		"prepare": "svelte-kit sync || echo ''",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "sh scripts/test-e2e.sh",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config scripts/better-auth.config.ts --output src/lib/server/db/auth.schema.ts --yes && prettier --write src/lib/server/db/auth.schema.ts"
	},
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"better-auth": "^1.7.27",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"pg-boss": "^12.39.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/archivo": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-bun": "^1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^5.1.1",
		"auth": "^1.7.27",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"d3-shape": "^3.2.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"layerchart": "^2.11.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"valibot": "^1.5.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
