{
	"name": "homefit",
	"private": true,
	"version": "0.1.0",
	"description": "Self-hosted dashboard for sleep, training and health data.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config scripts/better-auth.config.ts --output src/lib/server/db/auth.schema.ts --yes && prettier --write src/lib/server/db/auth.schema.ts"
	},
	"dependencies": {
		"better-auth": "^1.7.12",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"pg-boss": "^12.38.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.60.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^5.0.5",
		"auth": "^1.7.12",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"d3-shape": "^3.2.0",
		"drizzle-kit": "^0.31.11",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"layerchart": "^2.8.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"valibot": "^1.5.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
